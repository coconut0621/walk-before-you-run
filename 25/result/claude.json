  "dataset_summary": {
    "plain_description": "ModelOff 2015 Round 1 Section 3 tax calculation dataset. Contains 132 months of taxable profit/loss data (January 2015 to December 2025), a 13-band tax rate schedule with date ranges, tax payment installment schedule, and a 2-year tax loss expiry parameter.",
    "n_tables": 3,
    "notes": "Taxable profits are normalized from a wide monthly time series. The tax rate schedule's last entry uses 'Onwards' rather than an end date. Losses expire after 2 years per section 1.04."
  }

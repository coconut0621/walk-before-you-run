  "dataset_summary": {
    "dataset_name": "MO15 Tax Data Financial Model",
    "n_tables": 4,
    "logical_description": "A tax financial model from ModelOff 2015 consisting of a global timeline period dimension, a set of tax assumptions, a large fact table representing the core financial workings unpivoted by period, and a metadata table capturing spreadsheet format styling conventions.",
    "notes": [
      "The horizontal period arrays in Assumptions and Workings were extracted and normalized into a single period dimension table (T1).",
      "The Workings matrix was unpivoted from its wide 'one column per period' format into a normalized long fact table (T3).",
      "Tax assumption parameters were extracted as a vertical key-value pair table (T2)."
    ]
  }

  "dataset_summary": {
    "plain_description": "ModelOff 2016 Round 1 Section 3 dice rolling dataset. Contains 6,000 scored turns across 3,000 games, each turn recording six individual die outcomes (values 1-6). The Formats sheet provides the workbook's cell formatting legend.",
    "n_tables": 3,
    "notes": "Each game has exactly 2 turns. Turns are the primary fact table with six die-roll columns per row. The Games dimension is derived from the distinct game_number values in the Turns table. The FormattingLegend table documents workbook cell style conventions and is not part of the dice data model."
  }

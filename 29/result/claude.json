  "dataset_summary": {
    "plain_description": "ModelOff 2014 Round 2 widget company financial model inputs. Contains 8 widget product definitions with price categories, 15-year annual sales volume forecasts for each widget, per-category unit pricing schedules (Base and Growth scenarios), and scalar financial assumptions (COGS rates, overheads, working capital, capex, depreciation, financing).",
    "n_tables": 4,
    "notes": "Sales volumes and pricing are normalized from wide 15-year time series. Forecasts start FY2016 (year ending June 30, 2016)."
  }
